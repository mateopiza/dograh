# Dograh en el VPS de Agentrix. Copiar a la RAÍZ del repo como `.env`:
#   cp deploy/agentrix/.env.example .env && chmod 600 .env
# Generar cada secreto con: openssl rand -hex 32

# --- Versión (api y ui siempre con la MISMA etiqueta) ---------------------
DOGRAH_VERSION=1.47.0
REGISTRY=dograhai

# --- Hosts públicos (registros DNS A hacia la IP del VPS) -----------------
DOGRAH_UI_HOST=voice.agentrixlabs.com.co
DOGRAH_API_HOST=voice-api.agentrixlabs.com.co

# --- Traefik de Dokploy -----------------------------------------------------
TRAEFIK_NETWORK=dokploy-network
TRAEFIK_ENTRYPOINT=websecure
TRAEFIK_WEB_ENTRYPOINT=web
TRAEFIK_CERTRESOLVER=letsencrypt

# --- Almacenamiento S3 (Megas4) — sustituye a MinIO -------------------------
# Bucket propio para Dograh (grabaciones, transcripciones, documentos).
# El navegador sube con URLs firmadas: el bucket necesita CORS que permita
# PUT/GET desde https://voice.agentrixlabs.com.co.
S3_BUCKET=
S3_REGION=
# Con https:// (ej. https://s3.eu-luxembourg-2.megas4.com)
S3_ENDPOINT_URL=
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
# path funciona con cualquier nombre de bucket (también con puntos)
S3_ADDRESSING_STYLE=path
S3_SIGNATURE_VERSION=s3v4

# --- WebRTC / coturn (UDP público) ------------------------------------------
# IPv4 pública del VPS. No usar un host que pase por el proxy de Cloudflare.
TURN_HOST=
TURN_SECRET=
FORCE_TURN_RELAY=false

# --- Secretos ---------------------------------------------------------------
OSS_JWT_SECRET=
# No cambiar después del primer arranque: queda grabado en el volumen.
POSTGRES_PASSWORD=
REDIS_PASSWORD=

# Firma del WebSocket de medios de telefonía. Primero solo el secreto
# (los tokens inválidos se registran), luego ENFORCE=true con logs limpios.
TELEPHONY_WS_TOKEN_SECRET=
TELEPHONY_WS_TOKEN_ENFORCE=false

# --- Registro de usuarios ---------------------------------------------------
# true SOLO para crear el primer usuario; después volver a false.
ENABLE_SIGNUP=false
